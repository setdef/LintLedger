module Alibi
  # Text from a project, made safe to print: a file's text, a path, or a message that
  # quotes one must not move the cursor, clear the screen, set the title of the terminal,
  # or crash Alibi on a byte that isn't UTF-8.
  #
  # === Examples
  #
  #   Alibi::Escaped.new("a\e[2J.rb").to_s
  #   # => "a\\x1B[2J.rb"
  class Escaped
    CONTROL: Regexp

    @text: String

    # The text +text+, as printed.
    def initialize: (String text) -> void

    # The text with each control character, from C0 or C1, other than a tab, and each
    # byte that isn't UTF-8, shown as the escapes of its bytes, such as `\x1B` for the
    # escape character, and `\xC2\x9B` for the C1 character that some terminals read as
    # the start of a control sequence.
    def to_s: () -> String

    private def escape: (String text) -> String
  end
end
