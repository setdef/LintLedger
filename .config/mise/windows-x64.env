# What `ridk enable` sets for RubyInstaller's x64 UCRT Ruby besides PATH
# and RI_DEVKIT (mise.toml), as RubyInstaller's
# lib/ruby_installer/build/msys2_installation.rb sets them; MAKE as
# ruby/setup-ruby sets it. mise.toml reads this file on Windows only.
MAKE=make
MSYSTEM=UCRT64
MSYSTEM_PREFIX=/ucrt64
MSYSTEM_CARCH=x86_64
MSYSTEM_CHOST=x86_64-w64-mingw32
MINGW_CHOST=x86_64-w64-mingw32
MINGW_PREFIX=/ucrt64
MINGW_PACKAGE_PREFIX=mingw-w64-ucrt-x86_64
PKG_CONFIG_PATH=/ucrt64/lib/pkgconfig:/ucrt64/share/pkgconfig
ACLOCAL_PATH=/ucrt64/share/aclocal:/usr/share/aclocal
MANPATH=/ucrt64/share/man
